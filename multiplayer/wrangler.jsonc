{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valo",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://valonow.langcheng.uk,https://langcheng945.github.io,http://127.0.0.1:8000,http://localhost:8000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ]
}
